generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?
  image            String?
  phone            String?
  job              String?
  groupId          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime?       @updatedAt
  lastLogin        DateTime?
  role             Role?
  authority        Authority?
  accounts         Account[]
  managementGroups Group[]         @relation("GroupManager")
  owningGroup      Group?          @relation("GroupOwner")
  project          Project[]
  projectThread    ProjectThread[]
  sessions         Session[]
  taskReport       TaskReport[]
  tasks            TaskWorker[]
  group            Group?          @relation(fields: [groupId], references: [id])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  expires      DateTime
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Group {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  ownerId        String          @unique
  managerId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplyGroupId  String?
  manager        User?           @relation("GroupManager", fields: [managerId], references: [id])
  owner          User?           @relation("GroupOwner", fields: [ownerId], references: [id])
  supplyGroup    Group?          @relation("SupplyGroup", fields: [supplyGroupId], references: [id])
  demandGroups   Group[]         @relation("SupplyGroup")
  projects       Project[]
  members        User[]
  businessInfo   BusinessInfo?   @relation("GroupBusinessInfo")
  membershipInfo MembershipInfo? @relation("GroupMembershipInfo")
}

model BusinessInfo {
  groupId        String    @id
  businessType   Int
  companyName    String?
  ceoName        String?
  address        String?
  businessNumber String?
  category       String?
  workforceSize  String?
  foundingDate   DateTime?
  group          Group     @relation("GroupBusinessInfo", fields: [groupId], references: [id], onDelete: Cascade)
}

model MembershipInfo {
  groupId        String           @id
  membershipType Int
  status         MembershipStatus
  startDate      DateTime         @default(now())
  membership     MembershipData   @relation("usingMembership", fields: [membershipType], references: [id])
  group          Group            @relation("GroupMembershipInfo", fields: [groupId], references: [id])
}

model MembershipData {
  id              Int              @id
  type            MembershipType
  name            String
  description     String?
  cost            Int?
  membershipGroup MembershipInfo[] @relation("usingMembership")
}

model Project {
  id                  String           @id @default(cuid())
  name                String
  groupId             String
  projectTemplateName String
  request_startDate   DateTime?
  request_endDate     DateTime?
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  message             String?
  managerId           String?
  status              ProjectStatus?
  difficulty          Int              @default(2)
  group               Group            @relation(fields: [groupId], references: [id])
  manager             User?            @relation(fields: [managerId], references: [id])
  projectTemplate     ProjectTemplate? @relation(fields: [projectTemplateName], references: [name])
  threads             ProjectThread[]
  tasks               Task[]
}

model Task {
  id          String       @id @default(cuid())
  name        String
  isMilestone Boolean
  projectId   String?
  startDate   DateTime?
  endDate     DateTime?
  isComplete  Boolean      @default(false)
  project     Project?     @relation(fields: [projectId], references: [id])
  taskReport  TaskReport[]
  workers     TaskWorker[]

  @@unique([name, projectId])
}

model TaskWorker {
  id        String @id @default(cuid())
  taskId    String
  userId    String
  inputRate Int
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskReport {
  id                Int      @id @default(autoincrement())
  taskId            String
  userId            String
  standardInputRate Int
  todayInputRate    Int
  message           String?
  date              DateTime @default(now())
  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id])

  @@unique([taskId, userId, date])
}

model ProjectThread {
  id        Int            @id @default(autoincrement())
  projectId String
  authorId  String?
  type      ProjectStatus?
  createdAt DateTime       @default(now())
  message   String?
  author    User?          @relation(fields: [authorId], references: [id])
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectTemplate {
  id           Int            @id @default(autoincrement())
  category     String?
  name         String         @unique
  project      Project[]
  taskTemplate TaskTemplate[]
}

model TaskTemplate {
  id                  Int             @id @default(autoincrement())
  projectTemplateName String
  isMilestone         Boolean         @default(true)
  order               Int?            @default(0)
  name                String
  description         String?
  standardAmount      String?
  cost                Int?            @default(1)
  projectTemplate     ProjectTemplate @relation(fields: [projectTemplateName], references: [name])
}

enum Authority {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  REQUEST
  STANDBY
  LIVE
  COMPLETE
  STOP
  CANCEL
}

enum MembershipStatus {
  EXPIRES
  PAYING
  ETC
}

enum MembershipType {
  SUPPLY
  DEMAND
}

enum Role {
  MANAGER
  WORKER
}
